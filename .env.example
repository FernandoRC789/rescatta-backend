# ============================================================
# Rescatta Backend - variables de entorno de ejemplo
# Copia este archivo como .env (no lo subas al repo) y completa los valores.
#
# Nota: Spring Boot no carga .env automáticamente. Úsalo como plantilla para
# configurar las variables en Render o en la configuración de tu IDE / shell.
# ============================================================

# --- Base de datos ---
DB_URL=jdbc:mysql://localhost:3306/rescatta?useSSL=false&serverTimezone=America/Lima&createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=cambia_esta_password

# --- Firebase Admin SDK ---
# Contenido completo del JSON de la cuenta de servicio, en una sola línea.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- Storage de imágenes ---
# local | r2 | cloudinary
# En local usa "local". En producción (Render) usa "cloudinary" o "r2".
STORAGE_PROVIDER=local

# --- Opción A: Cloudinary (free tier, sin tarjeta) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rescatta

# --- Opción B: Cloudflare R2 ---
# STORAGE_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=rescatta-images
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_REGION=auto

# --- Seguridad / CORS ---
RESCATTA_SUPERADMIN_SECRET=cambia_este_secret_y_borralo_despues_del_bootstrap
RESCATTA_CORS_ORIGINS=http://localhost:5173

# --- Servidor ---
PORT=8081
